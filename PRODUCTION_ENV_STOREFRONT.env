# ========================================
# Storefront Production Environment Variables
# ========================================

# Medusa Backend
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.mawgood.cloud
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_3e5434677a64beba278f80dfdd444cb978debabab7f445b20b2977233cd37c53

# Site Configuration
NEXT_PUBLIC_BASE_URL=https://mawgood.cloud
NEXT_PUBLIC_SITE_NAME=Mawgood - موجود
NEXT_PUBLIC_SITE_DESCRIPTION=موقع إلكتروني يضم كل المنتجات المحلية المصرية والعربية

# Default Region & Currency
NEXT_PUBLIC_DEFAULT_REGION=eg
NEXT_PUBLIC_DEFAULT_CURRENCY=EGP

# Analytics (إذا كنت تستخدم Google Analytics)
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Facebook Pixel (إذا كنت تستخدم)
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=...

# Algolia Search (إذا كنت تستخدم)
# NEXT_PUBLIC_ALGOLIA_APP_ID=...
# NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=...
# NEXT_PUBLIC_ALGOLIA_INDEX_NAME=products

# Feature Flags
NEXT_PUBLIC_ENABLE_WISHLIST=true
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_ENABLE_CHAT=true

# Image Optimization
NEXT_PUBLIC_IMAGE_DOMAINS=api.mawgood.cloud,mawgood.cloud

# Revalidation (ISR)
REVALIDATE_TIME=3600
