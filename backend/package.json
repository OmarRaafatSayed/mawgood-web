{
  "name": "medusa-starter-default",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "seed": "medusa db:migrate && medusa exec ./scripts/seed.ts",
    "seed:no-migrate": "medusa exec ./scripts/seed.ts",
    "import:excel": "medusa exec ./scripts/import-excel-products.ts",
    "import:simple": "medusa exec ./scripts/import-products-simple.ts",
    "import:professional": "medusa exec ./scripts/import-products-professional.ts",
    "clean:products": "medusa exec ./scripts/clean-and-reimport-with-images.ts",
    "update:products": "medusa exec ./scripts/update-products-info.ts",
    "update:images": "medusa exec ./scripts/update-product-images.ts",
    "check:products": "medusa exec ./scripts/check-products.ts",
    "check:regions": "medusa exec ./scripts/check-regions.ts",
    "link:sales-channel": "medusa exec ./scripts/link-products-to-sales-channel.ts",
    "fix:visibility": "medusa exec ./scripts/fix-excel-products-visibility.ts",
    "clean:categories": "medusa exec ./scripts/clean-default-categories.ts",
    "db:cleanup-import": "medusa exec ./scripts/full-database-cleanup-and-import.ts",
    "check:readiness": "medusa exec ./scripts/check-import-readiness.ts",
    "fix:categories": "medusa exec ./scripts/fix-categories-from-products.ts",
    "production:build": "NODE_ENV=production medusa build",
    "production:start": "NODE_ENV=production medusa start",
    "production:migrate": "NODE_ENV=production medusa db:migrate",
    "production:seed": "NODE_ENV=production medusa db:migrate && NODE_ENV=production medusa exec ./scripts/seed.ts",
    "dev:full": "concurrently \"medusa develop\" \"medusa start\"",
    "db:migrate": "medusa db:migrate",
    "db:migrate-check": "node -e \"require('child_process').execSync('medusa db:migrate --dry-run', {stdio:'inherit'})\" 2>/dev/null || medusa db:migrate --check",
    "db:reset": "medusa db:reset",
    "db:setup": "medusa db:create && medusa db:migrate",
    "export:data": "medusa exec ./scripts/export-data-for-migration.ts",
    "import:data": "medusa exec ./scripts/import-data-from-export.ts",
    "production:import": "NODE_ENV=production medusa exec ./scripts/import-data-from-export.ts",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "3.25.76",
    "@medusajs/admin-sdk": "2.11.3",
    "@medusajs/cli": "2.11.3",
    "@medusajs/framework": "2.11.3",
    "@medusajs/medusa": "2.11.3",
    "@mercurjs/algolia": "^1.5.3",
    "@mercurjs/b2c-core": "^1.5.3",
    "@mercurjs/commission": "^1.5.3",
    "@mercurjs/framework": "^1.5.3",
    "@mercurjs/requests": "^1.5.3",
    "@mercurjs/resend": "^1.5.3",
    "@mercurjs/reviews": "^1.5.3",
    "axios": "^1.7.2",
    "compression": "^1.8.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.11.3",
    "@swc/core": "1.5.7",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.2.11",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
