# ============================================================
# Backend — Development Environment
# ============================================================
# This file is loaded automatically when NODE_ENV=development.
# Safe to commit — contains NO real secrets.
# ============================================================

NODE_ENV=development
PORT=9000

# ── Database ─────────────────────────────────────────────────
# Local PostgreSQL. If your password has special chars, encode them:
#   @ → %40   # → %23   % → %25   ! → %21   $ → %24
DATABASE_URL=postgresql://postgres:02486@localhost:5432/mercurjs
DB_NAME=mercurjs

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Security (dev-only weak secrets — never use in production) ─
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# ── CORS (all local dev ports) ───────────────────────────────
STORE_CORS=http://localhost:3000,http://localhost:8000,http://localhost:9000
ADMIN_CORS=http://localhost:5173,http://localhost:9000,http://localhost:7001
VENDOR_CORS=http://localhost:5174,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:9000,https://docs.medusajs.com

# ── Seed credentials (used only when running: yarn seed) ─────
# These are dev-only defaults — override in .env.production
SEED_ADMIN_EMAIL=admin@mawgood.cloud
SEED_ADMIN_PASSWORD=DevAdmin@123456
SEED_SELLER_EMAIL=seller@mawgood.cloud
SEED_SELLER_PASSWORD=DevSeller@123456
SEED_SELLER_STORE_NAME=Mawgood Store
