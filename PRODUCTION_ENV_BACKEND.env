# ========================================
# Backend Production Environment Variables
# ========================================

# Environment
NODE_ENV=production
PORT=9000

# Database (PostgreSQL on Hostinger)
DATABASE_URL=postgres://mawgood_user:Dawoodd!@#0123$%@localhost:5432/mawgood_db

# Security Secrets (✅ تم تغييرها)
JWT_SECRET=Daw2@3#4$ood_Nada
COOKIE_SECRET=Daw2@3#4$ood_Nada

# CORS Configuration (✅ تم تحديثها)
STORE_CORS=https://mawgood.cloud,https://www.mawgood.cloud
ADMIN_CORS=https://admin.mawgood.cloud,https://mawgood.cloud
VENDOR_CORS=https://vendor.mawgood.cloud,https://mawgood.cloud
AUTH_CORS=https://mawgood.cloud,https://www.mawgood.cloud,https://admin.mawgood.cloud,https://vendor.mawgood.cloud

# Medusa Backend URLs
MEDUSA_BACKEND_URL=https://api.mawgood.cloud
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.mawgood.cloud

# Medusa Publishable Key (✅ المفتاح الصحيح)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_3e5434677a64beba278f80dfdd444cb978debabab7f445b20b2977233cd37c53

# Redis (للـ Cache والـ Queue)
REDIS_URL=redis://localhost:6379

# Admin User (للدخول الأول)
ADMIN_EMAIL=admin@mawgood.cloud
ADMIN_PASSWORD=ChangeThisPassword123!

# File Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./static

# Session Settings
SESSION_SECRET=Daw2@3#4$ood_Nada_Session

# Rate Limiting (حماية من الهجمات)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/backend.log

# Default Region
DEFAULT_REGION=eg
DEFAULT_CURRENCY=EGP

# Email Settings (إذا كنت تستخدم SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@mawgood.cloud

# Payment Gateway Settings (إذا كنت تستخدم)
# STRIPE_API_KEY=sk_live_...
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...

# S3 Storage (إذا كنت تستخدم AWS S3 للصور)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=mawgood-images

# Algolia Search (إذا كنت تستخدم)
# ALGOLIA_APP_ID=...
# ALGOLIA_ADMIN_API_KEY=...
# ALGOLIA_INDEX_NAME=products
