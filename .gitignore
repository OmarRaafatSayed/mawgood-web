# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
.turbo/
.medusa/

# Environment files
# ─ Safe to commit (no real secrets):
#     .env.template        ← schema/docs only
#     .env.development     ← local dev defaults
# ─ NEVER commit (real secrets):
#     .env                 ← active local override
#     .env.local           ← Next.js local override
#     .env.production      ← production secrets
#     .env.staging         ← staging secrets
.env
.env.local
.env.production
.env.staging
.env.test
# Allow safe files
!.env.template
!.env.development

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Coverage
coverage/
*.lcov

# Temp scripts (development only)
check-*.js
debug-*.js
fix-*.js
verify-*.js
build-preview.js
*.sql
*.py
*.bat
tokens.json

# AI Tools
.aider*
.kiro/

# PM2
.pm2/
pm2.log

# TypeScript
*.tsbuildinfo
*.tsbuildinfo.*

# Storybook
storybook-static/

# Testing
.nyc_output/

# Misc
.vercel
.yarn
.pnp.*

# Production (don't commit production env)
.env.production

# Turborepo
turbo-cache

# pnpm
.pnpm-store
.pnpm-debug.log
